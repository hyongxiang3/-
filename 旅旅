                      >
                        移除
                      </button>
                    </div>

                    {/* TRANSPORT RECOMMENDATION */}
                    {idx < itinerary.length - 1 && (
                      <div className="my-2 ml-4 flex items-center space-x-2 text-[11px] text-slate-500 bg-slate-100/80 px-3 py-1.5 rounded-lg w-fit">
                        <Navigation className="w-3 h-3 text-amber-700" />
                        <span>建議交通：租借 YouBike 2.0 或騎乘機車 (約 12 分鐘)</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* TAB 4: PASSPORT & ACHIEVEMENTS */}
        {activeTab === 'passport' && (
          <div className="max-w-3xl mx-auto space-y-6">
            <div className="bg-gradient-to-br from-amber-900 to-slate-900 text-amber-50 p-8 rounded-3xl shadow-xl space-y-4">
              <div className="flex justify-between items-start">
                <div>
                  <span className="text-xs text-amber-400 font-mono tracking-widest uppercase">Cultural Tourist Pass</span>
                  <h2 className="text-2xl font-serif font-bold">府城深度探索護照</h2>
                </div>
                <Award className="w-10 h-10 text-amber-400" />
              </div>

              <div className="pt-4 flex items-center space-x-6 border-t border-amber-800/60">
                <div>
                  <div className="text-2xl font-bold font-mono">3 / 12</div>
                  <div className="text-xs text-amber-300">解鎖勳章</div>
                </div>
                <div>
                  <div className="text-2xl font-bold font-mono">Lv. 2</div>
                  <div className="text-xs text-amber-300">巷弄漫遊者</div>
                </div>
              </div>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-3 gap-4">
              {[
                { name: '古蹟尋蹤者', desc: '造訪赤崁樓與安平古堡', unlocked: true },
                { name: '牛肉湯鑑賞家', desc: '解鎖 3 間在地牛肉湯', unlocked: true },
                { name: '夕陽追逐者', desc: '於漁光島完成簽到', unlocked: true },
                { name: '鹽田漫步者', desc: '造訪井仔腳瓦盤鹽田', unlocked: false },
                { name: '老屋咖啡客', desc: '探索神農街老屋咖啡', unlocked: false },
                { name: '藝術巡禮者', desc: '參觀南美館與奇美博物館', unlocked: false }
              ].map((badge, idx) => (
                <div 
                  key={idx}
                  className={`p-4 rounded-2xl border ${
                    badge.unlocked 
                      ? 'bg-white border-amber-300/80 shadow-sm' 
                      : 'bg-slate-100/50 border-slate-200 opacity-60'
                  } space-y-2`}
                >
                  <div className="w-8 h-8 rounded-full bg-amber-100 text-[#B23A22] flex items-center justify-center font-bold text-sm">
                    {badge.unlocked ? '✓' : '🔒'}
                  </div>
                  <h4 className="font-bold text-sm text-slate-900">{badge.name}</h4>
                  <p className="text-xs text-slate-500">{badge.desc}</p>
                </div>
              ))}
            </div>
          </div>
        )}

      </main>
    </div>
  );
}
